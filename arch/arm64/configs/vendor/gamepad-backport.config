# HID controller backport; does not change module-signature or root policy.
CONFIG_HID=y
CONFIG_USB_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_POWER_SUPPLY=y
CONFIG_CRC32=y
CONFIG_HID_PLAYSTATION=y
CONFIG_PLAYSTATION_FF=y
CONFIG_HID_NINTENDO=y
CONFIG_NINTENDO_FF=y
# CONFIG_NINTENDO_SWITCH2_USB is not set
# CONFIG_NINTENDO_SWITCH2_BLE is not set
CONFIG_INPUT_UINPUT=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
